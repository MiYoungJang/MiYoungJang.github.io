{%- if site.teachings -%}
{%- assign institution_order = "Dongduk Women's University,University of Pennsylvania" | split: "," -%}
{%- for institution in institution_order -%}
{%- assign institution_courses = site.teachings | where: "institution", institution -%}
{%- if institution_courses.size > 0 -%}
<div class="institution-section">
<h1 class="institution-name">{{ institution }}</h1>
<div class="courses">
{%- assign courses_by_year = institution_courses | sort: 'year' | reverse | group_by: 'year' -%}
{%- for year_group in courses_by_year -%}
{%- assign year_courses = year_group.items | sort: 'term' -%}
<h2 class="year">{{ year_group.name }}</h2>
<div class="course-list">
{%- for course in year_courses -%}
<div class="course-item">
<h3 class="course-title">{{ course.title }}</h3>
{%- if course.term -%}
<span class="course-term">{{ course.term }}</span>
{%- endif -%}
{%- if course.description == "Graduate course" -%}
<span class="course-level">Graduate course</span>
{%- endif -%}
</div>
{%- endfor -%}
</div>
{%- endfor -%}
</div>
</div>
{%- endif -%}
{%- endfor -%}
{%- else -%}
<p>No courses available yet.</p>
{%- endif -%}
